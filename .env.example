# 复制为 .env 后仅在本机填写；空值代表未配置。.env 已被 .gitignore 排除，不会提交。
# 在 Shopee 开放平台（https://open.shopee.com）的应用详情页获取：
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# live = 正式环境；sandbox = 测试环境
SHOPEE_ENVIRONMENT=live
# 可选：授权回跳地址，默认 http://127.0.0.1:8787/auth/callback
SHOPEE_REDIRECT_URL=

# 以下三项为旧版手动配置字段，仅用于“数据与接入”页的配置检查；
# 店铺令牌现在由授权流程自动保存到 .local/shopee-auth.json，一般无需填写。
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
